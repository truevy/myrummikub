{
  "database": {
    "rules": "database.rules.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "push",
      "runtime": "nodejs22",
      "predeploy": [
        "node \"$PROJECT_DIR/scripts/sync-functions.js\""
      ]
    }
  ],
  "hosting": [
    {
      "site": "lyndas-rummi-time",
      "public": "hosting",
      "ignore": [
        "**/.*"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
    {
      "site": "lyndas-rummikub",
      "public": "hosting",
      "ignore": [
        "**/.*"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    }
  ]
}
